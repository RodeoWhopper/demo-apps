{
  "name": "terracotta-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Terracotta Supply - SvelteKit 2 / Svelte 5 plant-pot shop demo with cookie sessions managed in hooks.server.ts",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3012",
    "build": "vite build",
    "preview": "vite preview --port 3012",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.2",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
