<%- include('../partials/head') %>
<h1 class="text-2xl font-bold">Admin dashboard</h1>
<p class="text-sm text-stone-500">Warehouse-wide reports. Only the <code>admin</code> role can see this page.</p>

<div class="mt-5 grid gap-4 sm:grid-cols-3">
  <div class="rounded-lg border border-stone-200 bg-white p-4"><p class="text-xs uppercase text-stone-500">Items</p><p class="text-2xl font-bold"><%= totals.items %></p></div>
  <div class="rounded-lg border border-stone-200 bg-white p-4"><p class="text-xs uppercase text-stone-500">Units on hand</p><p class="text-2xl font-bold"><%= totals.units.toLocaleString('en-US') %></p></div>
  <div class="rounded-lg border border-stone-200 bg-white p-4"><p class="text-xs uppercase text-stone-500">Stock value</p><p class="text-2xl font-bold">$<%= totals.value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p></div>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-2">
  <section class="rounded-lg border border-stone-200 bg-white shadow-sm">
    <h2 class="border-b border-stone-200 px-4 py-3 font-semibold">Low-stock report <span class="ml-1 rounded bg-amber-200 px-1.5 text-xs text-amber-900"><%= lowStock.length %></span></h2>
    <table class="min-w-full text-sm">
      <thead class="bg-stone-50 text-left text-xs uppercase text-stone-500"><tr><th class="px-4 py-2">SKU</th><th class="px-4 py-2">Name</th><th class="px-4 py-2 text-right">Qty</th><th class="px-4 py-2 text-right">Reorder at</th><th class="px-4 py-2 text-right">Shortfall</th></tr></thead>
      <tbody class="divide-y divide-stone-100">
        <% if (!lowStock.length) { %><tr><td colspan="5" class="px-4 py-6 text-center text-stone-500">Everything is above its reorder level.</td></tr><% } %>
        <% lowStock.forEach(function (i) { %>
          <tr>
            <td class="px-4 py-2 font-mono text-xs"><a href="/items/<%= i.id %>/edit" class="hover:underline"><%= i.sku %></a></td>
            <td class="px-4 py-2"><%= i.name %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= i.quantity %></td>
            <td class="px-4 py-2 text-right tabular-nums text-stone-500"><%= i.reorderLevel %></td>
            <td class="px-4 py-2 text-right tabular-nums font-semibold text-amber-800"><%= i.reorderLevel - i.quantity %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <div class="space-y-6">
    <section class="rounded-lg border border-stone-200 bg-white shadow-sm">
      <h2 class="border-b border-stone-200 px-4 py-3 font-semibold">By category</h2>
      <table class="min-w-full text-sm">
        <thead class="bg-stone-50 text-left text-xs uppercase text-stone-500"><tr><th class="px-4 py-2">Category</th><th class="px-4 py-2 text-right">Items</th><th class="px-4 py-2 text-right">Units</th><th class="px-4 py-2 text-right">Low</th><th class="px-4 py-2 text-right">Value</th></tr></thead>
        <tbody class="divide-y divide-stone-100">
          <% byCategory.forEach(function (c) { %>
            <tr><td class="px-4 py-2"><a href="/items?category=<%= encodeURIComponent(c.name) %>" class="hover:underline"><%= c.name %></a></td><td class="px-4 py-2 text-right"><%= c.count %></td><td class="px-4 py-2 text-right"><%= c.units %></td><td class="px-4 py-2 text-right"><%= c.low %></td><td class="px-4 py-2 text-right tabular-nums">$<%= c.value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="rounded-lg border border-stone-200 bg-white shadow-sm">
      <h2 class="border-b border-stone-200 px-4 py-3 font-semibold">Users</h2>
      <table class="min-w-full text-sm">
        <thead class="bg-stone-50 text-left text-xs uppercase text-stone-500"><tr><th class="px-4 py-2">Username</th><th class="px-4 py-2">Role</th><th class="px-4 py-2">Created</th></tr></thead>
        <tbody class="divide-y divide-stone-100">
          <% users.forEach(function (u) { %>
            <tr><td class="px-4 py-2 font-medium"><%= u.username %></td><td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs font-semibold <%= u.role === 'admin' ? 'bg-depot-100 text-depot-700' : 'bg-stone-100 text-stone-600' %>"><%= u.role %></span></td><td class="px-4 py-2 text-stone-500"><%= u.createdAt.slice(0, 10) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </div>
</div>
<%- include('../partials/foot') %>
