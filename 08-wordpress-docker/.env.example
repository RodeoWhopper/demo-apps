# Copy to .env  (cp .env.example .env). All values below are DEMO values – change them for a real deployment.

# --- Database (MariaDB, internal network only) ---
WORDPRESS_DB_NAME=cinar
WORDPRESS_DB_USER=cinar
WORDPRESS_DB_PASSWORD=change-me-demo-db-pass
MARIADB_ROOT_PASSWORD=change-me-demo-root-pass
WORDPRESS_TABLE_PREFIX=wp_

# --- Public URL. Change BOTH when the site is served from another host/domain (e.g. https://cinar.example.com) ---
WP_HOME=http://localhost:8008
WP_SITEURL=http://localhost:8008

# Appended verbatim to wp-config.php by the official image. Keep as-is: it turns WP_HOME / WP_SITEURL above into PHP constants,
# which override whatever is stored in the database, so changing the domain never requires a search-replace.
WORDPRESS_CONFIG_EXTRA=define('WP_HOME', getenv('WP_HOME') ?: 'http://localhost:8008'); define('WP_SITEURL', getenv('WP_SITEURL') ?: 'http://localhost:8008');

# --- Admin account created by setup.sh (only used on first install) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=Admin123!
WP_ADMIN_EMAIL=admin@cinar.local
