# Scribble API (Flask) - demo values, safe locally. Copy to .env or export.
JWT_SECRET=change-me-demo-jwt-secret
SECRET_KEY=change-me-demo-flask-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# SQLite file (absolute, or relative to the project root)
DATABASE_PATH=data/scribble.db
# Seed demo users/notes automatically when the users table is empty
AUTO_SEED=1
# CORS allowed origins ("*" or comma-separated list)
CORS_ORIGINS=*
PORT=5004
GUNICORN_WORKERS=2
