# Port the panel listens on
PORT=8000
# Bind address. Keep 127.0.0.1 unless you protect the panel with PANEL_TOKEN (it runs docker commands!)
HOST=127.0.0.1
# Optional shared secret. When set, every /api request must carry it (header x-panel-token or ?token=)
PANEL_TOKEN=
# Folder that contains the NN-* app folders. Defaults to the parent of this folder.
DEMO_APPS_ROOT=
# How many "start" jobs (docker builds) may run at the same time
BUILD_CONCURRENCY=2
# Status poll interval in milliseconds
POLL_INTERVAL_MS=4000
# Host name used to build "Open" links and health probes
PUBLIC_HOST=localhost
