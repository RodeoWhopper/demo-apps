# Pergament (Django) - demo values, safe to use locally. Copy to .env or export.
DJANGO_SECRET_KEY=change-me-demo-secret-pergament
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins with scheme, only needed behind an HTTPS proxy, e.g. https://blog.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# SQLite file path (absolute, or relative to the project root)
DJANGO_DB_PATH=data/db.sqlite3
PORT=8003
GUNICORN_WORKERS=2
