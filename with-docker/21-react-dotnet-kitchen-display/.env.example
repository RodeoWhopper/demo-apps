# Ocakbaşı KDS – every value is optional; defaults shown. All secrets here are DEMO values.
ASPNETCORE_URLS=http://+:8021
ASPNETCORE_ENVIRONMENT=Production

# HS256 key for access tokens (min 32 chars). CHANGE THIS outside of demos.
JWT_SECRET=change-me-demo-secret-ocakbasi-kds-32chars
JWT_ISSUER=ocakbasi-kds
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Set to true when the app is served over HTTPS so the kds_refresh cookie gets the Secure flag.
COOKIE_SECURE=false
# Set to true behind a reverse proxy so X-Forwarded-For/Proto are honoured (rate limiting keys on client IP).
TRUST_PROXY_HEADERS=false

# Only needed when the SPA is served from a different origin (Vite dev server). Production is same-origin.
CORS_ORIGINS=http://localhost:5021
# Fixed-window limit for POST /api/orders per client IP.
ORDERS_PER_MINUTE=10

# SQLite connection string; the directory is created automatically. Docker image default: /app/data/kds.db
ConnectionStrings__Default=Data Source=data/kds.db
