# Copy to .env (cp .env.example .env). DEMO values – change for a real deployment.

# Public URL Ghost is served from. Must match the scheme/host/port visitors use (put a TLS proxy in front for https).
GHOST_URL=http://localhost:8010

# MySQL (internal network only)
MYSQL_ROOT_PASSWORD=change-me-demo-root
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me-demo-ghost

# Mail transport (Direct = try to deliver directly, usually blocked; use SMTP + mail__options__* for real newsletters)
MAIL_TRANSPORT=Direct
# Set to true only when SMTP is configured: Ghost then e-mails a verification code on every new staff login
STAFF_DEVICE_VERIFICATION=false

# Owner account created by scripts/setup-owner.sh (Ghost requires a password of at least 10 characters)
GHOST_OWNER_NAME=Sığınak Editörü
GHOST_OWNER_EMAIL=owner@siginak.dev
GHOST_OWNER_PASSWORD=Owner123!!
