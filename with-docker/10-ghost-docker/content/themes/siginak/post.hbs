{{!< default}}

{{#post}}
<article class="post {{post_class}}">
    <header class="post__header container narrow">
        {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <h1 class="post__title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post__excerpt">{{custom_excerpt}}</p>{{/if}}
        <p class="post__meta">
            {{#primary_author}}<a href="{{url}}">{{name}}</a>{{/primary_author}}
            · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            {{#if @custom.show_reading_time}}· {{reading_time}}{{/if}}
        </p>
    </header>

    {{#if feature_image}}
    <figure class="post__feature-image container">
        <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <section class="gh-content post__content container narrow">
        {{content}}
    </section>

    <footer class="post__footer container narrow">
        {{#if tags}}<p class="post__tags">{{tags prefix="Etiketler: " separator=" · "}}</p>{{/if}}
        {{> "subscribe"}}
    </footer>
</article>
{{/post}}
