{{!< default}}

{{#author}}
<section class="page-head container narrow">
    <p class="eyebrow">Yazar</p>
    <h1>{{name}}</h1>
    {{#if bio}}<p class="page-head__lead">{{bio}}</p>{{/if}}
    {{#if website}}<p><a href="{{website}}" rel="noopener">{{website}}</a></p>{{/if}}
</section>
{{/author}}

<section class="container">
    <div class="post-feed">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
