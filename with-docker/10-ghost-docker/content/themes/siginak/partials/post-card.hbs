<article class="post-card{{#if feature_image}} post-card--image{{/if}}">
    {{#if feature_image}}
    <a class="post-card__image" href="{{url}}">
        <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
    </a>
    {{/if}}
    <div class="post-card__body">
        {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <h2 class="post-card__title"><a href="{{url}}">{{title}}</a></h2>
        <p class="post-card__excerpt">{{excerpt words="32"}}</p>
        <p class="post-card__meta">
            {{#if primary_author}}<span>{{primary_author.name}}</span> · {{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
            {{#if @custom.show_reading_time}} · {{reading_time}}{{/if}}
        </p>
    </div>
</article>
