# Orbit Tasks API - demo values, safe locally
JWT_SECRET=change-me-demo-orbit-jwt-secret
ACCESS_TOKEN_MINUTES=60
# SQLAlchemy URL; relative sqlite paths resolve against the working directory (api/)
DATABASE_URL=sqlite:///./data/orbit.db
# Comma-separated browser origins allowed by CORS (the Vite dev/preview server)
CORS_ORIGINS=http://localhost:5015,http://127.0.0.1:5015
AUTO_SEED=1
PORT=8015
