<%- include('../partials/head') %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Inventory</h1>
    <p class="text-sm text-stone-500"><%= items.length %> item<%= items.length === 1 ? '' : 's' %> shown · <%= lowCount %> below reorder level</p>
  </div>
  <a href="/items/new" class="rounded bg-depot-500 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-depot-400">+ New item</a>
</div>

<form method="get" action="/items" class="mt-5 flex flex-wrap items-center gap-3 rounded-lg border border-stone-200 bg-white p-3 text-sm">
  <input name="q" value="<%= filters.q %>" placeholder="Search name or SKU" class="w-56 rounded border border-stone-300 px-3 py-1.5">
  <select name="category" class="rounded border border-stone-300 px-3 py-1.5">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <label class="flex items-center gap-1"><input type="checkbox" name="low" value="1" <%= filters.low ? 'checked' : '' %>> Low stock only</label>
  <button class="rounded border border-stone-300 px-3 py-1.5 hover:bg-stone-50">Filter</button>
  <a href="/items" class="text-stone-500 hover:underline">Reset</a>
</form>

<div class="mt-4 overflow-x-auto rounded-lg border border-stone-200 bg-white shadow-sm">
  <table class="min-w-full text-sm">
    <thead class="bg-stone-50 text-left text-xs uppercase tracking-wide text-stone-500">
      <tr>
        <th class="px-4 py-2">SKU</th>
        <th class="px-4 py-2">Name</th>
        <th class="px-4 py-2">Category</th>
        <th class="px-4 py-2">Location</th>
        <th class="px-4 py-2 text-right">Qty</th>
        <th class="px-4 py-2 text-right">Reorder at</th>
        <th class="px-4 py-2 text-right">Unit price</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% if (!items.length) { %>
        <tr><td colspan="8" class="px-4 py-8 text-center text-stone-500">No items match the filter.</td></tr>
      <% } %>
      <% items.forEach(function (item) { %>
        <tr class="<%= isLowStock(item) ? 'bg-amber-50/60' : '' %>">
          <td class="px-4 py-2 font-mono text-xs"><%= item.sku %></td>
          <td class="px-4 py-2 font-medium"><%= item.name %></td>
          <td class="px-4 py-2 text-stone-600"><%= item.category %></td>
          <td class="px-4 py-2 font-mono text-xs text-stone-600"><%= item.location %></td>
          <td class="px-4 py-2 text-right tabular-nums">
            <%= item.quantity %>
            <% if (isLowStock(item)) { %><span class="ml-1 rounded bg-amber-200 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-amber-900">low</span><% } %>
          </td>
          <td class="px-4 py-2 text-right tabular-nums text-stone-500"><%= item.reorderLevel %></td>
          <td class="px-4 py-2 text-right tabular-nums">$<%= item.unitPrice.toFixed(2) %></td>
          <td class="px-4 py-2 text-right">
            <div class="flex justify-end gap-2">
              <a href="/items/<%= item.id %>/edit" class="rounded border border-stone-300 px-2 py-1 text-xs hover:bg-stone-50">Edit</a>
              <% if (user.role === 'admin') { %>
                <form method="post" action="/items/<%= item.id %>/delete" onsubmit="return confirm('Delete <%= item.sku %>?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="rounded border border-red-200 px-2 py-1 text-xs text-red-700 hover:bg-red-50">Delete</button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
