@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Erişim reddedildi";
}
<div class="text-center py-5">
    <p class="display-1 fw-bold text-secondary">403</p>
    <h1 class="h3">Bu sayfaya erişim yetkiniz yok</h1>
    <p class="text-muted">@(Model.ReturnUrl is null ? "" : $"İstenen adres: {Model.ReturnUrl}") Yönetim sayfaları yalnızca Admin rolü içindir.</p>
    <a class="btn btn-primary" asp-page="/Index">Ana sayfa</a>
</div>
