@page
@model Helpdesk.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "Yeni bilet";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-page="/Tickets/Index">Biletler</a></li><li class="breadcrumb-item active">Yeni bilet</li></ol></nav>
<div class="card p-4" style="max-width: 760px">
    <h1 class="h3 mb-3">Yeni destek bileti</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Başlık</label>
            <input asp-for="Input.Title" class="form-control" placeholder="Sorunu tek cümleyle özetleyin" />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <label asp-for="Input.CategoryId" class="form-label">Kategori</label>
                <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Seçin…</option>
                </select>
                <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.Priority" class="form-label">Öncelik</label>
                <select asp-for="Input.Priority" class="form-select">
                    @foreach (TicketPriority p in Enum.GetValues<TicketPriority>())
                    {
                        <option value="@p">@Labels.Priority(p)</option>
                    }
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label">Açıklama</label>
            <textarea asp-for="Input.Description" class="form-control" rows="6" placeholder="Ne oldu, ne zaman başladı, hata mesajı var mı?"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Bileti aç</button>
            <a class="btn btn-outline-secondary" asp-page="/Tickets/Index">Vazgeç</a>
        </div>
    </form>
</div>
