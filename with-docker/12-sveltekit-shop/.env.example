# HTTP port / bind address for the adapter-node server (`node build`)
PORT=3012
HOST=0.0.0.0

# Public origin of the site (scheme + host + port as users see it). SvelteKit's form-action CSRF check
# compares the browser's Origin header against it, so it MUST match the public URL
# (e.g. https://shop.example.com). `npm start` / the Docker image default it to http://localhost:3012.
ORIGIN=http://localhost:3012

# Set to "true" behind HTTPS so session/cart cookies get the Secure flag
COOKIE_SECURE=false

# Directory holding users.json / sessions.json / products.json / orders.json (default ./data; /app/data in Docker)
# DATA_DIR=/app/data
