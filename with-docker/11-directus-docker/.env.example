# Copy to .env (cp .env.example .env). DEMO values – rotate for a real deployment.

# Directus secrets (SECRET signs tokens; generate with: openssl rand -base64 32)
DIRECTUS_KEY=change-me-demo-key
DIRECTUS_SECRET=change-me-demo-secret-please-rotate-me

# First admin user (created by Directus on first boot only)
ADMIN_EMAIL=admin@kilavuz.dev
ADMIN_PASSWORD=Admin123!

# Postgres (internal network only)
POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me-demo-db
POSTGRES_DB=directus

# Public URL of the Directus API/admin as seen by browsers (change when deployed under a domain)
PUBLIC_URL=http://localhost:8011
# Allowed browser origins for the API ("*" or comma-separated list, e.g. https://events.example.com)
CORS_ORIGIN=*
