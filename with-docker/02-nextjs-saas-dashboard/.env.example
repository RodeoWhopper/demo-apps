# Secret used to sign the HS256 session JWT (demo value - change in real deployments)
AUTH_SECRET=change-me-demo-secret-lumeo

# Port the production server listens on (Dockerfile sets it to 3002 too)
PORT=3002

# Set to "true" when serving behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# Bind address for the standalone server (default 0.0.0.0)
# HOST=0.0.0.0

# Directory where data/db.json is stored (defaults to ./data; /app/data in Docker)
# DATA_DIR=/app/data
