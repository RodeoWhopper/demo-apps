# Root .env for `docker compose` (cp .env.example .env). These values are interpolated into the cms service;
# the same variables (plus DATABASE_*) are read from cms/.env when running Strapi locally (see cms/.env.example).
# DEMO secrets – regenerate for real use: openssl rand -base64 32
APP_KEYS=demo-app-key-one,demo-app-key-two,demo-app-key-three,demo-app-key-four
API_TOKEN_SALT=demo-api-token-salt
ADMIN_JWT_SECRET=demo-admin-jwt-secret
TRANSFER_TOKEN_SALT=demo-transfer-token-salt
JWT_SECRET=demo-jwt-secret
ENCRYPTION_KEY=demo-encryption-key-change-me
