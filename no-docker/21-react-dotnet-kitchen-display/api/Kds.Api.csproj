<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kds.Api</RootNamespace>
    <AssemblyName>Kds.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>ocakbasi-kds-demo</UserSecretsId>
    <!-- Keep the local publish output and the SQLite data directory out of the default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);out/**;data/**</DefaultItemExcludes>
    <!-- Location of the Vite production build (see IncludeSpaInPublish below). -->
    <SpaDist>../web/dist</SpaDist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <!--
    `dotnet publish` bundles the React build into the publish output as wwwroot/ whenever ../web/dist exists
    (after `npm run build`). `dotnet run` does not publish, so Program.cs
    additionally falls back to ../web/dist as the web root when no wwwroot/ folder is present.
  -->
  <Target Name="IncludeSpaInPublish" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(SpaDist)')">
    <ItemGroup>
      <SpaDistFiles Include="$(SpaDist)/**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high" Text="Kds.Api: bundling SPA from $(SpaDist) into wwwroot/" />
  </Target>

</Project>
