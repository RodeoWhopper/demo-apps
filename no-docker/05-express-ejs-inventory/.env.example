# Secret used to sign the express-session cookie (demo value - change in production)
SESSION_SECRET=change-me-demo-secret-depot

# HTTP port / bind address
PORT=3005
HOST=0.0.0.0

# Set to "true" behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# Set to "true" when running behind a reverse proxy (enables Express trust proxy)
TRUST_PROXY=false

# Directory holding inventory.json (defaults to ./data)
# DATA_DIR=./data
