<%- include('partials/head') %>
<div class="mx-auto mt-10 max-w-sm rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
  <h1 class="text-xl font-bold">Sign in</h1>
  <p class="mt-1 text-sm text-stone-500">Server-side session (express-session) with a CSRF token per session.</p>
  <% if (error) { %>
    <p role="alert" class="mt-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800"><%= error %></p>
  <% } %>
  <form method="post" action="/login" class="mt-5 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="username" class="block text-sm font-medium">Username</label>
      <input id="username" name="username" value="<%= username %>" required autofocus autocomplete="username"
             class="mt-1 w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-depot-500 focus:outline-none focus:ring-2 focus:ring-depot-100">
    </div>
    <div>
      <label for="password" class="block text-sm font-medium">Password</label>
      <input id="password" name="password" type="password" required autocomplete="current-password"
             class="mt-1 w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-depot-500 focus:outline-none focus:ring-2 focus:ring-depot-100">
    </div>
    <button class="w-full rounded bg-depot-500 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-depot-400">Sign in</button>
  </form>
  <div class="mt-5 rounded bg-stone-50 p-3 text-xs text-stone-600">
    <p class="font-medium text-stone-700">Demo accounts</p>
    <p class="mt-1"><code>admin</code> / <code>admin123</code> (admin - can delete items, see /admin)</p>
    <p><code>clerk</code> / <code>clerk123</code> (clerk - create and edit items)</p>
  </div>
</div>
<%- include('partials/foot') %>
