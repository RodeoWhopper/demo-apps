<%- include('partials/head') %>
<div class="mx-auto mt-16 max-w-md rounded-lg border border-stone-200 bg-white p-8 text-center shadow-sm">
  <p class="text-6xl font-black text-depot-500"><%= status %></p>
  <h1 class="mt-2 text-lg font-semibold"><%= status === 403 ? 'Forbidden' : 'Something went wrong' %></h1>
  <p class="mt-2 text-sm text-stone-500"><%= message %></p>
  <a href="/items" class="mt-6 inline-block rounded bg-depot-500 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-depot-400">Back to inventory</a>
</div>
<%- include('partials/foot') %>
