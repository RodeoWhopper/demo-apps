# Pulsebox - copy to .env (Bun loads .env automatically)
# "development" enables GET /dev/last-code and shows the OTP on the verify page; use "production" to disable both
APP_ENV=development
PORT=3020
# demo value - replace with a real secret (HMAC key for the session cookie)
SESSION_SECRET=change-me-demo-secret
# comma-separated list of emails that get the admin role
ADMIN_EMAILS=admin@pulsebox.app
# SQLite file (created + seeded on first start)
DB_PATH=data/pulsebox.sqlite
