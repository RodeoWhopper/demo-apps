# Copy to .env (cp .env.example .env). DEMO secrets – regenerate for anything real:
#   for v in APP_KEYS API_TOKEN_SALT ADMIN_JWT_SECRET TRANSFER_TOKEN_SALT JWT_SECRET ENCRYPTION_KEY; do echo "$v=$(openssl rand -base64 32)"; done
# (APP_KEYS may be a comma-separated list of several keys.)
HOST=0.0.0.0
PORT=1337
APP_KEYS=demo-app-key-one,demo-app-key-two,demo-app-key-three,demo-app-key-four
API_TOKEN_SALT=demo-api-token-salt
ADMIN_JWT_SECRET=demo-admin-jwt-secret
TRANSFER_TOKEN_SALT=demo-transfer-token-salt
JWT_SECRET=demo-jwt-secret
ENCRYPTION_KEY=demo-encryption-key-change-me

# Database – SQLite file (relative to the cms folder). Postgres/MySQL are supported by config/database.ts (DATABASE_CLIENT=postgres|mysql + DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Browser origins allowed to call the API (comma separated). "*" for the demo.
CORS_ORIGIN=*
